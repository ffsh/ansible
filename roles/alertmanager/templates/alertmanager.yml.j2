global:
  resolve_timeout: 5m

route:
  receiver: telegram
  group_by: ["alertname", "instance"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 3h

receivers:
  - name: telegram
    telegram_configs:
      - bot_token: {{ vault_secrets.alertmanager.telegram_bot_token | to_json }}
        chat_id: {{ vault_secrets.alertmanager.telegram_chat_id }}
        send_resolved: true
        message: |
          {% raw %}{{ if eq .Status "firing" }}{{ range .Alerts }}
          {{ if eq .Labels.alertname "WireguardDown" }}
          THE {{ .Labels.target }} WIREGUARD TUNNEL HAS LEFT THE BUILDING

          The WireGuard exit connection on {{ .Labels.target }} has been down for over 5 minutes.

          The tunnel may be offline, unreachable, or taking an unscheduled holiday.

          Severity: {{ .Labels.severity }}
          Check: {{ .Labels.job }}
          {{ else }}
          THE {{ .Labels.target }} SERVER HAS LEFT THE BUILDING

          The HTTPS check for {{ .Labels.target }} has failed for over 5 minutes.

          The server may be offline, unreachable, or contemplating its life choices.

          Severity: {{ .Labels.severity }}
          Check: {{ .Labels.job }}
          {{ end }}{{ end }}{{ else }}{{ range .Alerts }}
          {{ if eq .Labels.alertname "WireguardDown" }}
          {{ .Labels.target }} WIREGUARD IS BACK

          The WireGuard exit connection on {{ .Labels.target }} is responding normally again.

          The tunnel has returned from its brief adventure.
          {{ else }}
          {{ .Labels.target }} IS BACK

          The HTTPS check for {{ .Labels.target }} is responding normally again.

          The server has returned from its brief adventure.
          {{ end }}{{ end }}{{ end }}{% endraw %}