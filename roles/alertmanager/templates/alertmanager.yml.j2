global:
  resolve_timeout: 5m

route:
  receiver: telegram
  group_by: ["alertname", "instance"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 3h

receivers:
  - name: telegram
    telegram_configs:
      - bot_token: {{ vault_secrets.alertmanager.telegram_bot_token | to_json }}
        chat_id: {{ vault_secrets.alertmanager.telegram_chat_id }}
        send_resolved: true