global:
  resolve_timeout: 5m

route:
  receiver: telegram
  group_by: ["alertname", "instance"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 3h

receivers:
  - name: telegram
    telegram_configs:
      - bot_token: {{ vault_secrets.alertmanager.telegram_bot_token | to_json }}
        chat_id: {{ vault_secrets.alertmanager.telegram_chat_id }}
        send_resolved: true
        parse_mode: HTML
        message: |
          {% raw %}{{ if eq .Status "firing" }}{{ range .Alerts }}
          {{ if eq .Labels.alertname "WireguardDown" }}
          <b>{{ .Labels.target }}</b>

          ❗ WireGuard tunnel is down.

          Please check.
          {{ else if eq .Labels.alertname "ProbeDnsFailed" }}
          <b>{{ .Labels.target }}</b>

          ❗ DNS check failed.

          Please check.
          {{ else if eq .Labels.alertname "CertificateExpiryWarning" }}
          <b>{{ .Labels.target }}</b>

          ⚠️ TLS certificate expires within 30 days.

          Please renew or check Certbot.
          {{ else if eq .Labels.alertname "CertificateExpiryCritical" }}
          <b>{{ .Labels.target }}</b>

          ❗ TLS certificate expires within 14 days.

          Please renew or check Certbot urgently.
          {{ else if eq .Labels.alertname "CertbotRenewalDryRunFailed" }}
          <b>{{ .Labels.instance }}</b>

          ❗ Certbot renewal dry-run failed.

          Please check Certbot and nginx configuration.
          {{ else }}
          <b>{{ .Labels.target }}</b>
          
          ❗ HTTPS check failed.

          Please check.
          {{ end }}{{ end }}{{ else }}{{ range .Alerts }}
          {{ if eq .Labels.alertname "WireguardDown" }}
          <b>{{ .Labels.target }}</b>

          ✅ WireGuard tunnel is up again.
          {{ else if eq .Labels.alertname "ProbeDnsFailed" }}
          <b>{{ .Labels.target }}</b>

          ✅ DNS check is up again.
          {{ else }}
          <b>{{ .Labels.target }}</b>

          ✅ HTTPS check is up again.

          {{ end }}{{ end }}{{ end }}{% endraw %}