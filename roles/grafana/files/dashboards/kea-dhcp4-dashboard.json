{
    "annotations": {
        "list": []
    },
    "editable": true,
    "graphTooltip": 1,
    "panels": [
        {
            "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "mappings": [
                        {
                            "options": {
                                "0": {
                                    "color": "red",
                                    "text": "DOWN"
                                },
                                "1": {
                                    "color": "green",
                                    "text": "UP"
                                }
                            },
                            "type": "value"
                        }
                    ],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "red",
                                "value": 0
                            },
                            {
                                "color": "green",
                                "value": 1
                            }
                        ]
                    }
                },
                "overrides": []
            },
            "gridPos": {
                "h": 5,
                "w": 6,
                "x": 0,
                "y": 0
            },
            "id": 1,
            "options": {
                "colorMode": "background",
                "graphMode": "none",
                "orientation": "horizontal",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                }
            },
            "targets": [
                {
                    "expr": "up{job=\"kea-exporter\",target=~\"$target\"}",
                    "legendFormat": "{{target}}",
                    "refId": "A"
                }
            ],
            "title": "Exporter health",
            "type": "stat"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "axisLabel": "Pool utilization",
                        "axisPlacement": "auto",
                        "drawStyle": "line",
                        "fillOpacity": 12,
                        "lineWidth": 2,
                        "showPoints": "never"
                    },
                    "max": 100,
                    "min": 0,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": 0
                            },
                            {
                                "color": "orange",
                                "value": 80
                            },
                            {
                                "color": "red",
                                "value": 90
                            }
                        ]
                    },
                    "unit": "percent"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 9,
                "w": 18,
                "x": 6,
                "y": 0
            },
            "id": 2,
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "targets": [
                {
                    "expr": "100 * kea_dhcp4_addresses_assigned_total{target=~\"$target\",pool!=\"\"} / kea_dhcp4_addresses_total{target=~\"$target\",pool!=\"\"}",
                    "legendFormat": "{{target}} {{subnet}} {{pool}}",
                    "refId": "A"
                }
            ],
            "title": "Pool utilization",
            "type": "timeseries"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "axisLabel": "Allocation failures in 5 minutes",
                        "axisPlacement": "auto",
                        "drawStyle": "line",
                        "fillOpacity": 12,
                        "lineWidth": 2,
                        "showPoints": "never"
                    },
                    "min": 0,
                    "unit": "short"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 9
            },
            "id": 3,
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "targets": [
                {
                    "expr": "sum by (target, subnet, context) (delta(kea_dhcp4_allocations_failed_total{target=~\"$target\"}[5m]))",
                    "legendFormat": "{{target}} {{subnet}} {{context}}",
                    "refId": "A"
                }
            ],
            "title": "Allocation failures",
            "type": "timeseries"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "axisLabel": "Packets per second",
                        "axisPlacement": "auto",
                        "drawStyle": "line",
                        "fillOpacity": 12,
                        "lineWidth": 2,
                        "showPoints": "never"
                    },
                    "min": 0,
                    "unit": "pps"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 9
            },
            "id": 4,
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "targets": [
                {
                    "expr": "sum by (target, operation) (rate(kea_dhcp4_packets_received_total{target=~\"$target\"}[5m]))",
                    "legendFormat": "{{target}} received {{operation}}",
                    "refId": "A"
                },
                {
                    "expr": "sum by (target, operation) (rate(kea_dhcp4_packets_sent_total{target=~\"$target\"}[5m]))",
                    "legendFormat": "{{target}} sent {{operation}}",
                    "refId": "B"
                }
            ],
            "title": "DHCPv4 packet rates",
            "type": "timeseries"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "axisLabel": "Dropped packets per second",
                        "axisPlacement": "auto",
                        "drawStyle": "line",
                        "fillOpacity": 12,
                        "lineWidth": 2,
                        "showPoints": "never"
                    },
                    "min": 0,
                    "unit": "pps"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 7,
                "w": 24,
                "x": 0,
                "y": 17
            },
            "id": 5,
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "targets": [
                {
                    "expr": "sum by (target) (rate(kea_dhcp4_packets_received_total{target=~\"$target\",operation=\"drop\"}[5m]))",
                    "legendFormat": "{{target}}",
                    "refId": "A"
                }
            ],
            "title": "DHCPv4 packet drops",
            "type": "timeseries"
        }
    ],
    "refresh": "30s",
    "schemaVersion": 39,
    "tags": [
        "freifunk",
        "kea",
        "dhcp"
    ],
    "templating": {
        "list": [
            {
                "current": {},
                "label": "Datasource",
                "name": "datasource",
                "query": "prometheus",
                "type": "datasource"
            },
            {
                "current": {
                    "text": "All",
                    "value": "$__all"
                },
                "definition": "label_values(up{job=\"kea-exporter\"}, target)",
                "includeAll": true,
                "label": "Gateway",
                "multi": true,
                "name": "target",
                "query": {
                    "query": "label_values(up{job=\"kea-exporter\"}, target)",
                    "refId": "StandardVariableQuery"
                },
                "refresh": 1,
                "type": "query"
            }
        ]
    },
    "time": {
        "from": "now-6h",
        "to": "now"
    },
    "title": "Kea DHCPv4 (v1.0.0)",
    "uid": "kea-dhcp4",
    "version": 1
}