bind any:{{ fastd_client_listen_port }} interface "{{ fastd_client_listen_interface }}";

user "ffsh";

interface "{{ fastd_client_interface }}";

mode tap;

mtu {{ fastd_client_mtu }};

{% for method in fastd_client_method | reject('equalto', '') | reject('equalto', none) %}
method "{{ method }}";
{% endfor %}

secret "{{ fastd_client_secret }}";

log to syslog level debug;

include peers from "gateways";

on verify "true";

on up "
 ip link set dev $INTERFACE up
{% if fastd_client_fastd_mac | length > 0 %}
 ip link set dev $INTERFACE address {{ fastd_client_fastd_mac }}
{% endif %}
 ifup {{ fastd_client_bat_interface }}
 batctl meshif {{ fastd_client_bat_interface }} if add $INTERFACE
";

on down "
 ifdown {{ fastd_client_bat_interface }}
";
